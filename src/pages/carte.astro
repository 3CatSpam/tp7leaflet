---
import "leaflet/dist/leaflet.css";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Carte de France (Leaflet)">
  <main class="p-4 flex flex-col gap-4">
    <h1 class="text-2xl">Carte de France (Leaflet)</h1>
    <p id="description-carte">
      Carte interactive de la France métropolitaine, centrée sur le pays au niveau de zoom 6.
      Chaque point bleu représente un établissement ; cliquez dessus pour afficher son nom.
      Lorsque la carte a le focus, les touches fléchées déplacent la vue et les touches + et − zooment.
    </p>
    <p id="statut-carte" aria-live="polite"></p>
    <div
      id="map"
      role="region"
      aria-label="Carte interactive des établissements"
      aria-describedby="description-carte"
      class="w-full"
      style="height: 600px;"></div>

    <details>
      <summary>Voir la liste des établissements</summary>
      <table>
        <caption>Établissements affichés sur la carte</caption>
        <thead>
          <tr>
            <th scope="col">Nom</th>
            <th scope="col">Latitude</th>
            <th scope="col">Longitude</th>
          </tr>
        </thead>
        <tbody id="liste-etablissements"></tbody>
      </table>
    </details>
  </main>
</Layout>

<script>
  import * as L from "leaflet";
  import etablissements from "../assets/listetablissement.json";

  const carte = L.map("map").setView([46.6033, 1.883], 6);

  L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
    maxZoom: 19,
    attribution:
      '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
  }).addTo(carte);

  const elmStatut = document.getElementById("statut-carte") as HTMLParagraphElement;
  const elmListe = document.getElementById("liste-etablissements") as HTMLTableSectionElement;

  etablissements.forEach((e) => {
    const contenu = document.createElement("span");
    contenu.textContent = e.name;

    L.circleMarker([e.lat, e.lon], {
      radius: 5,
      color: "#1d4ed8",
      weight: 1,
      fillOpacity: 0.7,
    })
      .bindPopup(contenu)
      .addTo(carte);
  });

  elmStatut.textContent = `${etablissements.length} établissements affichés.`;

  elmListe.replaceChildren(
    ...etablissements.map((e) => {
      const ligne = document.createElement("tr");
      const nom = document.createElement("th");
      nom.scope = "row";
      nom.textContent = e.name;
      const lat = document.createElement("td");
      lat.textContent = String(e.lat);
      const lon = document.createElement("td");
      lon.textContent = String(e.lon);
      ligne.append(nom, lat, lon);
      return ligne;
    }),
  );
</script>
